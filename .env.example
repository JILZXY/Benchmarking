# =============================================================================
# ETICORE DB Benchmark - variables de entorno
# Copiar a .env y ajustar credenciales:  cp .env.example .env
#
# Los límites del motor (ENGINE_*, MONGO_WT_CACHE_GB, PG_*) NO se definen aquí:
# provienen del perfil experimental en config/profiles/*.env, que se pasa como
# segundo --env-file (ver scripts/setup/compose.ps1 o compose.sh).
# =============================================================================

COMPOSE_PROJECT_NAME=eticore-bench

# --- Imágenes (versiones fijas; nunca "latest") --------------------------------
MONGO_IMAGE=mongo:8.0.12
POSTGRES_IMAGE=postgres:17.6-bookworm
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.52.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1
RUNNER_PYTHON_IMAGE=python:3.12.11-slim-bookworm
RUNNER_IMAGE_TAG=0.1.0

# --- Credenciales (solo laboratorio local) -------------------------------------
MONGO_ROOT_USER=bench
MONGO_ROOT_PASSWORD=change-me-mongo
MONGO_DB=eticore
POSTGRES_USER=bench
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=eticore

# --- Dataset -------------------------------------------------------------------
DATASET_SEED=20261030
DATASET_SIZE=500000
DATASET_AVG_RESPUESTAS=3

# --- Puertos publicados (solo 127.0.0.1) ---------------------------------------
MONGO_HOST_PORT=27018
POSTGRES_HOST_PORT=15432
PROMETHEUS_HOST_PORT=9090
CADVISOR_HOST_PORT=8080
NODE_EXPORTER_HOST_PORT=9100

# --- Motores -------------------------------------------------------------------
# Memoria compartida de PostgreSQL (/dev/shm). Es un máximo y cuenta dentro de
# ENGINE_MEM_LIMIT.
PG_SHM_SIZE=256m
# Intervalo de healthcheck de los motores. Tras el arranque los chequeos son de
# costo casi nulo (TCP / pg_isready).
HEALTHCHECK_INTERVAL=15s
# Fijación opcional de núcleos (vacío = sin fijar). Ejemplo para separar el
# motor de la monitorización y del runner en una máquina de 24 hilos:
#   ENGINE_CPUSET=0-3   MONITORING_CPUSET=8-9   RUNNER_CPUSET=12-15
ENGINE_CPUSET=
MONITORING_CPUSET=
RUNNER_CPUSET=

# --- Monitorización (límites propios, fuera del motor evaluado) ----------------
PROMETHEUS_RETENTION=30d
PROMETHEUS_CPUS=1
PROMETHEUS_MEM_LIMIT=1024m
CADVISOR_CPUS=1
CADVISOR_MEM_LIMIT=512m
NODE_EXPORTER_CPUS=0.5
NODE_EXPORTER_MEM_LIMIT=128m

# --- Runner --------------------------------------------------------------------
RUNNER_CPUS=4
RUNNER_MEM_LIMIT=1536m
