# PROFILE_A_BASELINE - 4 CPU / 4096 MB / sin swap
# Uso: docker compose --env-file .env --env-file config/profiles/profile_a_baseline.env ...
BENCH_PROFILE=PROFILE_A_BASELINE
ENGINE_CPUS=4
ENGINE_MEM_LIMIT=4096m
# Caché principal del motor = 25 % de la RAM del perfil (ver docs/decisions/ADR-002)
MONGO_WT_CACHE_GB=1
PG_SHARED_BUFFERS=1024MB
PG_EFFECTIVE_CACHE_SIZE=2048MB

