# PROFILE_B_MEDIUM - 2 CPU / 2048 MB / sin swap
# Uso: docker compose --env-file .env --env-file config/profiles/profile_b_medium.env ...
BENCH_PROFILE=PROFILE_B_MEDIUM
ENGINE_CPUS=2
ENGINE_MEM_LIMIT=2048m
# Caché principal del motor = 25 % de la RAM del perfil (ver docs/decisions/ADR-002)
MONGO_WT_CACHE_GB=0.5
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1024MB

