# PROFILE_C_SEVERE - 1 CPU / 1024 MB / sin swap
# Uso: docker compose --env-file .env --env-file config/profiles/profile_c_severe.env ...
BENCH_PROFILE=PROFILE_C_SEVERE
ENGINE_CPUS=1
ENGINE_MEM_LIMIT=1024m
# Caché principal del motor = 25 % de la RAM del perfil (ver docs/decisions/ADR-002).
# 0.25 GB es el mínimo admitido por WiredTiger.
MONGO_WT_CACHE_GB=0.25
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=512MB

